# content-ops — credentials template.
# Copy to `.env.local` (gitignored) and fill in. NEVER commit the real file.
# Scripts read these via scripts/lib/env.mjs.

# --- Publishing switch -------------------------------------------------------
# LIVE=0 → shadow mode (generate + queue + notify, publish NOTHING). Default.
# LIVE=1 → actually publish via the APIs below.
LIVE=0
# DRY_RUN=1 forces every post-*.mjs to print the payload and hit no API (overrides LIVE).
DRY_RUN=1

# --- dev.to --- API key: Settings → Extensions → DEV Community API Keys
DEVTO_API_KEY=

# --- Mastodon ----------------------------------------------------------------
# Preferences → Development → New application (scope: write) → copy the token.
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky (AT Protocol) ---------------------------------------------------
# Settings → App Passwords → create one. Use the handle + app password (NOT your real password).
BLUESKY_SERVICE=https://bsky.social
BLUESKY_HANDLE=            # e.g. micelclaw.bsky.social
BLUESKY_APP_PASSWORD=

# --- Telegram ----------------------------------------------------------------
# @BotFather → create bot → add it as ADMIN of your channel. chat_id via getUpdates (e.g. @channel or -100...).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Facebook Page (Graph API) -----------------------------------------------
# Meta app + Business Verification + long-lived Page Access Token. Blank → script skips with a notice.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Instagram (Graph API, shares the Meta app above) ------------------------
# IG Business/Creator account linked to the Page. Blank → script skips with a notice.
INSTAGRAM_USER_ID=
# Uses FACEBOOK_PAGE_ACCESS_TOKEN unless a dedicated token is given:
INSTAGRAM_ACCESS_TOKEN=

# --- Notifications (where the daily/weekly summary is sent) -------------------
# Reuses the Telegram bot above by default; set a separate chat to receive ops notices.
NOTIFY_TELEGRAM_CHAT_ID=

# --- Screenshots / visuals ---------------------------------------------------
# The dash to capture (product UI). Paco Trueno session is used (never admin).
DASH_BASE_URL=http://localhost:7100
PACO_USER_ID=dd4d75fb

# Quien hace el paso MANUAL de TikTok (tocar la notificación del buzón, pegar la descripción y
# elegir/subir portada). El bot le manda ahí el texto a pegar. OJO: Telegram NO permite que un bot
# inicie conversación → esa persona tiene que escribirle al bot UNA vez. Si no se la puede
# alcanzar, el aviso se reencamina a NOTIFY_TELEGRAM_CHAT_ID.
TIKTOK_PUBLISHER_TELEGRAM_CHAT_ID=
TIKTOK_PUBLISHER_NAME=
