---
import Base from './Base.astro';
import { X } from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  tags: string[];
  image?: string;
}

const { title, description, date, author, tags, image } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const slug = Astro.url.pathname;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  author: { "@type": "Person", name: author },
  datePublished: date.toISOString(),
  publisher: {
    "@type": "Organization",
    name: "Micelclaw",
    logo: { "@type": "ImageObject", url: "https://micelclaw.com/images/favicon.png" },
  },
  ...(image && { image: image.startsWith("http") ? image : `https://micelclaw.com${image}` }),
};
---

<Base
  title={`${title} | Micelclaw Blog`}
  description={description}
  canonicalPath={slug}
  ogType="article"
  ogImage={image}
  jsonLd={articleJsonLd}
>
  <main class="blog-post">
    <article>
      <header class="post-header">
        <div class="post-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          <span class="meta-sep">&middot;</span>
          <span>{author}</span>
        </div>
        <h1>{title}</h1>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </header>
      <div class="post-content">
        <slot />
      </div>
    </article>
  </main>

  <!-- Lightbox overlay (hidden until an image is clicked) -->
  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="Close"><X size={20} /></button>
    <img class="lightbox-img" alt="" />
  </div>

  <script>
    // Click any image inside .post-content → show lightbox at full size.
    // Esc or click on backdrop closes it.
    document.addEventListener('DOMContentLoaded', () => {
      const overlay = document.getElementById('lightbox');
      if (!overlay) return;
      const img = overlay.querySelector('.lightbox-img') as HTMLImageElement | null;
      const closeBtn = overlay.querySelector('.lightbox-close');
      if (!img || !closeBtn) return;

      const open = (src: string, alt: string) => {
        img.src = src;
        img.alt = alt;
        overlay.classList.add('open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        overlay.classList.remove('open');
        overlay.setAttribute('aria-hidden', 'true');
        img.src = '';
        document.body.style.overflow = '';
      };

      document.querySelectorAll<HTMLImageElement>('.post-content img').forEach((el) => {
        el.style.cursor = 'zoom-in';
        el.addEventListener('click', () => open(el.currentSrc || el.src, el.alt));
      });

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay || e.target === img) close();
      });
      closeBtn.addEventListener('click', close);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay.classList.contains('open')) close();
      });
    });
  </script>
</Base>

<style is:global>
  .blog-post {
    max-width: 780px; margin: 0 auto; padding: 120px 24px 80px;
  }
  .post-header {
    margin-bottom: 48px;
  }
  .post-meta {
    font-family: var(--mono); font-size: 13px; color: var(--gray-400);
    margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
  }
  .meta-sep { opacity: 0.4; }
  .post-header h1 {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 42px); font-weight: 800; letter-spacing: 0.02em;
    line-height: 1.15; margin-bottom: 16px;
  }
  .post-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-family: var(--mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.06em; padding: 4px 10px; border-radius: 100px;
    background: rgba(0,200,255,0.06); color: var(--cyan-dim);
    border: 1px solid rgba(0,200,255,0.1);
  }

  /* Post content prose */
  .post-content {
    font-size: 17px; color: var(--text-light); line-height: 1.7;
  }
  .post-content h2 {
    font-family: var(--font-display);
    font-size: 20px; font-weight: 700; letter-spacing: 0.02em;
    margin: 48px 0 16px; color: var(--text-light);
    text-transform: uppercase;
  }
  .post-content h3 {
    font-size: 17px; font-weight: 600; margin: 32px 0 10px; color: var(--text-light);
  }
  .post-content p { margin-bottom: 16px; }
  .post-content a { color: var(--cyan-dim); text-decoration: underline; text-underline-offset: 2px; }
  .post-content a:hover { color: var(--cyan); }
  .post-content strong { color: var(--white); }
  .post-content ul, .post-content ol {
    margin: 8px 0 16px 20px; color: var(--text-light); line-height: 1.7;
  }
  .post-content li { margin-bottom: 6px; }
  .post-content blockquote {
    margin: 20px 0; padding: 14px 20px;
    border-left: 3px solid var(--cyan); background: rgba(0,200,255,0.06);
    font-style: italic; color: var(--gray-600);
  }
  .post-content code {
    font-family: var(--mono); font-size: 14px;
    background: rgba(255,255,255,0.06); color: var(--cyan-bright);
    padding: 2px 6px; border-radius: 4px;
  }
  .post-content pre {
    margin: 24px 0; padding: 20px; border-radius: var(--radius-sm);
    overflow-x: auto; font-size: 13.5px; line-height: 1.6;
    border: 1px solid var(--border-dark);
  }
  .post-content pre code {
    background: none; padding: 0; font-size: inherit; color: inherit;
  }
  .post-content img {
    max-width: 100%; border-radius: var(--radius-sm); margin: 24px 0;
    border: 1px solid var(--border-dark);
    cursor: zoom-in;
    transition: opacity 0.15s;
  }
  .post-content img:hover { opacity: 0.92; }

  /* Lightbox overlay */
  .lightbox {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(0, 0, 0, 0.95);
    display: none;
    align-items: center; justify-content: center;
    padding: 0;
    cursor: zoom-out;
  }
  .lightbox.open { display: flex; }
  .lightbox-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .lightbox-close {
    position: fixed; top: 16px; right: 24px;
    width: 44px; height: 44px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: #fff; line-height: 1;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .lightbox-close:hover { background: rgba(255, 255, 255, 0.18); }
  .post-content table {
    width: 100%; border-collapse: collapse; margin: 20px 0;
    font-size: 14px;
  }
  .post-content thead th {
    text-align: left; padding: 10px 14px;
    background: rgba(0,200,255,0.08); border-bottom: 2px solid rgba(0,200,255,0.15);
    font-weight: 600; color: var(--text-light); font-size: 12.5px;
    text-transform: uppercase; letter-spacing: 0.03em;
  }
  .post-content td {
    padding: 10px 14px; border-bottom: 1px solid var(--border-dark);
    color: var(--gray-600);
  }
  .post-content hr {
    border: none; border-top: 1px solid rgba(0,200,255,0.1);
    margin: 48px 0;
  }

  @media (max-width: 768px) {
    .blog-post { padding: 100px 20px 60px; }
  }
</style>
