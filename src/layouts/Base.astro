---
interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = "Free, open-source alternative to Google Workspace and Notion. Notes, calendar, email, files, photos, and AI assistant — all self-hosted on your hardware with local AI. Privacy-first, no cloud dependency.",
  canonicalPath,
  ogImage = "/images/og-default.png",
  ogType = "website",
  jsonLd,
} = Astro.props;

const siteUrl = "https://micelclaw.com";
const canonical = canonicalPath ? `${siteUrl}${canonicalPath}` : undefined;
const ogImageUrl = ogImage?.startsWith("http") ? ogImage : `${siteUrl}${ogImage ?? "/images/og-default.png"}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <meta name="author" content="Micelclaw">
  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:site_name" content="Micelclaw">
  <meta property="og:locale" content="en_US">
  {canonical && <meta property="og:url" content={canonical}>}
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  <link rel="icon" href="/images/favicon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png">
  <link rel="apple-touch-icon" href="/images/favicon.png">
  {canonical && <link rel="canonical" href={canonical}>}
  <link rel="alternate" type="application/rss+xml" title="Micelclaw Blog" href="/rss.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800;900&family=Exo+2:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>

  <nav id="nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">
        <img src="/images/favicon.png" alt="Micelclaw">
        Micelclaw
      </a>
      <div class="nav-links">
        <a href="/#features">Features</a>
        <a href="/#preview">Preview</a>
        <a href="/blog">Blog</a>
        <a href="https://docs.micelclaw.com" target="_blank" rel="noopener">Docs</a>
        <a href="https://github.com/micelclaw" target="_blank" rel="noopener">GitHub</a>
        <a href="/#waitlist" class="btn-cta">Join waitlist <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></a>
      </div>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="footer-inner">
      <span class="footer-left">&copy; 2026 Micelclaw</span>
      <div class="footer-social">
        <a href="https://github.com/micelclaw" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
