---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Blog — Building a Self-Hosted AI OS | Micelclaw"
  description="Engineering deep-dives on building an open-source personal OS: PostgreSQL hybrid search, knowledge graphs, AI agent optimization, pgvector, entity extraction, and self-hosting architecture."
  canonicalPath="/blog"
>
  <main class="blog-index">
    <header class="blog-header">
      <p class="section-label">Blog</p>
      <h1>Engineering notes &amp; updates</h1>
      <p class="blog-subtitle">Behind the scenes of building a personal OS.</p>
    </header>

    <div class="posts-grid">
      {posts.map(post => (
        <a href={`/blog/${post.id}`} class="post-card">
          <div class="card-meta">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="card-tags">
              {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
        </a>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="empty-state">No posts yet. Check back soon.</p>
    )}
  </main>
</Base>

<style>
  .blog-index {
    max-width: 800px; margin: 0 auto; padding: 120px 32px 80px;
  }
  .blog-header {
    text-align: center; margin-bottom: 64px;
  }
  .blog-header h1 {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 40px); font-weight: 800;
    letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 12px;
  }
  .blog-subtitle {
    font-size: 16px; color: var(--gray-400);
  }
  .posts-grid {
    display: flex; flex-direction: column; gap: 16px;
  }
  .post-card {
    display: block; padding: 28px 32px; border-radius: var(--radius);
    background: rgba(255,255,255,0.75); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.5);
    text-decoration: none; color: inherit;
    transition: all 0.3s ease;
  }
  .post-card:hover {
    background: rgba(255,255,255,0.9);
    border-color: rgba(0,200,255,0.15);
    box-shadow: 0 8px 40px rgba(0,0,0,0.06);
    transform: translateY(-2px);
  }
  .card-meta {
    font-family: var(--mono); font-size: 12px; color: var(--gray-400);
    margin-bottom: 10px;
  }
  .post-card h2 {
    font-family: var(--font-display);
    font-size: 17px; font-weight: 700; letter-spacing: 0.02em;
    text-transform: uppercase; margin-bottom: 8px; line-height: 1.3;
  }
  .post-card p {
    font-size: 14px; color: #444; line-height: 1.65;
  }
  .card-tags {
    display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px;
  }
  .tag {
    font-family: var(--mono); font-size: 10px; text-transform: uppercase;
    letter-spacing: 0.06em; padding: 3px 8px; border-radius: 100px;
    background: rgba(0,200,255,0.06); color: var(--cyan-dim);
    border: 1px solid rgba(0,200,255,0.1);
  }
  .empty-state {
    text-align: center; color: var(--gray-400); font-size: 15px; padding: 60px 0;
  }
  @media (max-width: 768px) {
    .blog-index { padding: 100px 20px 60px; }
    .post-card { padding: 20px 24px; }
  }
</style>
